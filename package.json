{
	"name": "saenslog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"generate:favicon": "node scripts/generate-favicon.mjs",
		"generate:og": "node scripts/generate-og-image.mjs",
		"generate:assets": "npm run generate:favicon --silent && npm run generate:og --silent",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:browser": "cross-env VITEST_BROWSER=1 vitest --run"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "*",
		"@eslint/compat": "*",
		"@eslint/js": "*",
		"@sveltejs/adapter-cloudflare": "*",
		"@sveltejs/kit": "*",
		"@sveltejs/vite-plugin-svelte": "*",
		"@types/node": "*",
		"@types/turndown": "*",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"cross-env": "*",
		"eslint": "*",
		"eslint-config-prettier": "*",
		"eslint-plugin-svelte": "*",
		"globals": "*",
		"playwright": "*",
		"png-to-ico": "*",
		"prettier": "*",
		"prettier-plugin-svelte": "*",
		"sharp": "*",
		"svelte": "*",
		"svelte-check": "*",
		"typescript": "*",
		"typescript-eslint": "*",
		"vite": "*",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "*",
		"wrangler": "^4.99.0"
	},
	"dependencies": {
		"@supabase/ssr": "*",
		"@supabase/supabase-js": "*",
		"@tiptap/core": "*",
		"@tiptap/extension-image": "*",
		"@tiptap/extension-link": "*",
		"@tiptap/extension-placeholder": "*",
		"@tiptap/extension-table": "*",
		"@tiptap/pm": "*",
		"@tiptap/starter-kit": "*",
		"dotenv": "*",
		"gray-matter": "*",
		"highlight.js": "*",
		"marked": "*",
		"marked-highlight": "*",
		"turndown": "*",
		"turndown-plugin-gfm": "*"
	}
}
