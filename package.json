{
	"name": "saenslog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"generate:favicon": "node scripts/generate-favicon.mjs",
		"generate:og": "node scripts/generate-og-image.mjs",
		"generate:assets": "npm run generate:favicon --silent && npm run generate:og --silent",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:browser": "cross-env VITEST_BROWSER=1 vitest --run"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260611.1",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^22",
		"@types/turndown": "^5.0.6",
		"@vitest/browser-playwright": "^4.0.5",
		"cross-env": "^10.1.0",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"playwright": "^1.56.1",
		"pm2": "^7.0.1",
		"png-to-ico": "^3.0.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"sharp": "^0.34.5",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vitest": "^4.0.5",
		"vitest-browser-svelte": "^2.0.1",
		"wrangler": "^4.99.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.10.2",
		"@supabase/supabase-js": "^2.105.1",
		"@tiptap/core": "^3.22.5",
		"@tiptap/extension-image": "^3.22.5",
		"@tiptap/extension-link": "^3.22.5",
		"@tiptap/extension-placeholder": "^3.22.5",
		"@tiptap/extension-table": "^3.22.5",
		"@tiptap/pm": "^3.22.5",
		"@tiptap/starter-kit": "^3.22.5",
		"dotenv": "^17.4.2",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.1",
		"marked-highlight": "^2.2.3",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	}
}
